{
  "publisher": "ririd",
  "name": "depdetect",
  "displayName": "depdetect",
  "version": "0.8.5-fix12",
  "private": true,
  "packageManager": "pnpm@8.12.0",
  "description": "Detects and manages dependencies versions in projects.",
  "author": "Riri <daydreamerriri@outlook.com>",
  "license": "MIT",
  "homepage": "https://github.com/Daydreamer-riri/vscode-ext-packages#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Daydreamer-riri/vscode-ext-packages"
  },
  "bugs": {
    "url": "https://github.com/Daydreamer-riri/vscode-ext-packages/issues"
  },
  "keywords": [
    "node",
    "npm",
    "go",
    "golang",
    "java",
    "maven",
    "javascript",
    "json"
  ],
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "main": "./dist/index.js",
  "icon": "res/logo.png",
  "files": [
    "dist"
  ],
  "engines": {
    "vscode": "^1.69.0"
  },
  "activationEvents": [
    "onLanguage:json",
    "onLanguage:toml",
    "onLanguage:go.mod",
    "onLanguage:xml",
    "workspaceContains:package.json",
    "workspaceContains:**/pyproject.toml",
    "workspaceContains:**/go.mod",
    "workspaceContains:**/pom.xml",
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "depdetect.replaceVersion",
        "title": "Do not call manually ! Replace Version of the provided dependency",
        "category": "🎈 DepDetect"
      },
      {
        "command": "depdetect.updateAll",
        "title": "Update All dependencies of the active dependency file",
        "category": "🎈 DepDetect"
      },
      {
        "command": "depdetect.retry",
        "title": "Retry to fetch the active dependency file",
        "category": "🎈 DepDetect"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "DepDetect",
      "properties": {
        "depdetect.errorDecorator": {
          "type": "string",
          "scope": "resource",
          "default": "❗️",
          "description": "The text to show when a dependency has errors."
        },
        "depdetect.incompatibleDecorator": {
          "type": "string",
          "scope": "resource",
          "default": "❌ ${version}",
          "description": "The text template to show when a dependency is not semver compatible. ${version} will be replaced by the latest version info."
        },
        "depdetect.compatibleDecorator": {
          "type": "string",
          "scope": "resource",
          "default": "✅",
          "description": "The text template to show when a dependency is semver compatible. ${version} will be replaced by the latest version info."
        }
      }
    }
  },
  "scripts": {
    "build": "tsup --external vscode",
    "dev": "pnpm run build --watch",
    "lint": "eslint .",
    "vscode:prepublish": "npm run build",
    "publish": "vsce publish",
    "pack": "vsce package",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "release": "bumpp && nr publish",
    "patch": "esno scripts/patch.ts"
  },
  "devDependencies": {
    "@ririd/eslint-config": "^1.0.3",
    "@types/node": "^18.15.11",
    "@types/npm-registry-fetch": "^8.0.7",
    "@types/vscode": "^1.69.0",
    "bumpp": "^9.3.0",
    "eslint": "^8.56.0",
    "esno": "^4.0.0",
    "node-cache": "5.1.2",
    "npm-registry-fetch": "^16.1.0",
    "ofetch": "^1.1.0",
    "p-limit": "^5.0.0",
    "pnpm": "^8.12.0",
    "rimraf": "^5.0.1",
    "semver": "^7.5.4",
    "tsup": "^8.0.1",
    "typescript": "^5.0.3",
    "vite": "^5.0.12",
    "vitest": "^1.2.2",
    "vsce": "^2.15.0"
  }
}
